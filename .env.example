# Supabase Postgres connection strings (Project Settings -> Database -> Connection string)
# Pooled (port 6543, pgbouncer) - used by the app at runtime (local dev + Vercel serverless)
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct (port 5432) - used only for schema apply / one-off data migration scripts
DIRECT_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Random long string used to sign login session cookies (e.g. `openssl rand -hex 32`).
# Must be the same value locally and on Vercel, or sessions won't verify across environments.
JWT_SECRET=
